# Mana Sathuluru - Environment Configuration Placeholder
# IMPORTANT: Never commit personal credentials or secret keys to version control.
# Copy this file to .env and configure your brand channels.

# Official Instagram Profile URL (Mana Sathuluru Instagram Channel)
VITE_INSTAGRAM_URL=https://www.instagram.com/mana_sathuluru/

# WhatsApp Contact Number in international format (e.g., 919876543210 without '+' or spaces)
# NOTE: This number is NEVER displayed as visible text on the website.
# It is only used to form the secure WhatsApp chat redirect link: https://wa.me/<number>
VITE_WHATSAPP_NUMBER=919000000000

# ==============================================================================
# UPI Direct-To-Pay & Real-Time Payment Scanner Configuration
# ==============================================================================
# Your UPI VPA (e.g., yourname@okaxis, yourname@ybl, yourname@paytm, phone@upi)
VITE_UPI_ID=your_upi_id@ybl
VITE_UPI_NAME=Mana Sathuluru

# ==============================================================================
# Supabase Configuration (For Private Contact Messages & Community Data)
# ==============================================================================
# Find these in your Supabase Dashboard: Project Settings -> API
# SECURITY RULE: Only provide the 'anon' public key. NEVER expose 'service_role' keys!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Alternative Private Contact Form Webhook (e.g., Formspree)
VITE_CONTACT_ENDPOINT=

# Public Contact Receiver Email (used for mailto fallback if endpoint is not set)
VITE_CONTACT_EMAIL=contact@manasathuluru.com

# ==============================================================================
# Gmail Direct Inbox Notification (via EmailJS - Free 200 emails/mo)
# ==============================================================================
# 1. Connect your Gmail at https://emailjs.com
# 2. Add your Service ID, Template ID, and Public Key below:
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional Social Channels (Leave empty if not yet active; only active ones will display)
VITE_YOUTUBE_URL=
VITE_FACEBOOK_URL=
